<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>Aurora.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\aurora.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <SelfContained>true</SelfContained>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\assets\aurora.ico" Link="aurora.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aurora.Core\Aurora.Core.csproj" />
    <ProjectReference Include="..\Aurora.Application\Aurora.Application.csproj" />
    <ProjectReference Include="..\Aurora.Infrastructure\Aurora.Infrastructure.csproj" />
    <ProjectReference Include="..\Aurora.Platform.Windows\Aurora.Platform.Windows.csproj" />
    <ProjectReference Include="..\Aurora.Presentation\Aurora.Presentation.csproj" />
    <ProjectReference Include="..\Aurora.Taskbar\Aurora.Taskbar.csproj" />
    <ProjectReference Include="..\Aurora.ControlCenter\Aurora.ControlCenter.csproj" />
    <ProjectReference Include="..\Aurora.Notifications\Aurora.Notifications.csproj" />
    <ProjectReference Include="..\Aurora.Widgets\Aurora.Widgets.csproj" />
    <ProjectReference Include="..\Aurora.Media\Aurora.Media.csproj" />
    <ProjectReference Include="..\Aurora.Workspaces\Aurora.Workspaces.csproj" />
    <ProjectReference Include="..\Aurora.Personalization\Aurora.Personalization.csproj" />
  </ItemGroup>
</Project>
