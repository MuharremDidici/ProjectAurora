<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\aurora.ico</ApplicationIcon>
    <AssemblyName Condition="'$(SetupAssemblyName)' == ''">Aurora-Kurulum-v2.0-x64</AssemblyName>
    <AssemblyName Condition="'$(SetupAssemblyName)' != ''">$(SetupAssemblyName)</AssemblyName>
    <Product>Project Aurora Kurulum Sihirbazı</Product>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Payload\Aurora-Payload.zip" LogicalName="AuroraPayload.zip" />
    <EmbeddedResource Include="..\..\assets\aurora-icon.png" LogicalName="AuroraIcon.png" />
  </ItemGroup>
</Project>
